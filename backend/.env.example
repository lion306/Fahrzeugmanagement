# Datenbankverbindung
DATABASE_URL=postgresql://username:password@localhost:5432/fahrzeugmanagement
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fahrzeugmanagement
DB_USER=username
DB_PASSWORD=password

# Server
PORT=3001
NODE_ENV=development

# JWT Secret für Authentifizierung
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Upload-Verzeichnis für PDF-Templates
UPLOAD_DIR=./uploads
